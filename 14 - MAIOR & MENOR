#include <stdio.h>

int main() {
    int i, numero, maiornumero = 0, menornumero = 1000;

    for(i = 0; i < 10; i++) {
        
        printf("me informe o %d numero: ", i + 1);
        scanf("%d", &numero);
        
        if(numero > maiornumero)
            maiornumero = numero;
        
        if(numero < menornumero)
            menornumero = numero;
    }


    printf("maior numero e: %d\nmenor numero e: %d", maiornumero, menornumero);
    
    return 0;
}
