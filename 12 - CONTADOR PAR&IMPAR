#include <stdio.h>

int main() {
    int i, contadorpar = 0, contadorimpar = 0, numero;
    
    printf("ME INFORME UM NUMERO: ");
    scanf("%d", &numero);
    
    for(i = 0; i < numero; i++) {
        
        if(i % 2 == 0)
            contadorpar++;
        else
            contadorimpar++;
    }

    printf("quantidade de pares: %d\nquantidade de impares: %d", contadorpar, contadorimpar);
    
    return 0;
}
